# Copy this file to server/.env for non-sensitive defaults.
# Secrets such as API keys should live in server/.env.secrets (ignored) or be
# injected via your hosting provider (Railway, etc.).

HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
OPENROUTER_REFERER=https://whitevue.local

# Primary models (Grok 4.1 - fastest and most capable)
CHAT_MODEL=x-ai/grok-4.1-fast
SOLVER_MODEL=x-ai/grok-4.1-fast
OCR_MODEL=x-ai/grok-4.1-fast

# Fallback models (free alternatives)
CHAT_MODEL_FALLBACK_1=x-ai/grok-4.1-fast:free
SOLVER_MODEL_FALLBACK_1=x-ai/grok-4.1-fast:free
OCR_MODEL_FALLBACK_1=x-ai/grok-4.1-fast:free

# Final fallback models (original free models)
CHAT_MODEL_FALLBACK_2=nvidia/nemotron-nano-12b-v2-vl:free
SOLVER_MODEL_FALLBACK_2=deepseek/deepseek-r1:free
OCR_MODEL_FALLBACK_2=nvidia/nemotron-nano-12b-v2-vl:free

# Leave blank here and supply via server/.env.secrets (ignored) or platform secrets (Railway).
OPENROUTER_API_KEY=

index 00000000..8299382f
--- /dev/null
+++ b/frontend/src/composables/useTransformTool.ts
@@ -0,0 +1,249 @@
+import { ref, Ref } from 'vue'
+import type { Shape, Vec2 } from '../model/transformTypes'
+
+type Interaction =
+    | {
+        kind: 'drag';
+        shapeIds: string[];
+        start: Vec2;
+        initialPos: Map<string, { x: number; y: number }>;
+    }
+    | {
+        kind: 'scale';
+        shapeIds: string[];
+        handle: 'nw' | 'ne' | 'se' | 'sw' | 'n' | 'e' | 's' | 'w';
+        start: Vec2;
+        initialBox: { x: number; y: number; width: number; height: number };
+        initialTransforms: Map<string, { x: number; y: number; scaleX: number; scaleY: number }>;
+    }
+    | {
+        kind: 'rotate';
+        shapeIds: string[];
+        center: Vec2;
+        startAngle: number;
+        initialAngles: Map<string, number>;
+    };
+
+export function useTransformTool(
+    shapes: Ref<Shape[]>,
+    selectedIds: Ref<Set<string>>,
+    selectionBox: Ref<{ x: number, y: number, width: number, height: number } | null>,
+    screenToWorld: (x: number, y: number) => Vec2,
+    scheduleRender: () => void,
+    onDragEnd?: () => void,
+    hitTestShape?: (p: Vec2) => string | null
+) {
+    const interaction = ref<Interaction | null>(null)
+
+    function getCanvasPoint(e: PointerEvent): Vec2 {
+        return screenToWorld(e.clientX, e.clientY)
+    }
+
+    function hitTestHandles(pt: Vec2): 'nw' | 'ne' | 'se' | 'sw' | 'n' | 'e' | 's' | 'w' | 'rotate' | null {
+        if (!selectionBox.value) return null
+        const box = selectionBox.value
+        const handleSize = 10; // Tolerance in world units (approx)
+
+        const handles = [
+            { name: 'nw', x: box.x, y: box.y },
+            { name: 'ne', x: box.x + box.width, y: box.y },
+            { name: 'se', x: box.x + box.width, y: box.y + box.height },
+            { name: 'sw', x: box.x, y: box.y + box.height },
+            { name: 'n', x: box.x + box.width / 2, y: box.y },
+            { name: 'e', x: box.x + box.width, y: box.y + box.height / 2 },
+            { name: 's', x: box.x + box.width / 2, y: box.y + box.height },
+            { name: 'w', x: box.x, y: box.y + box.height / 2 },
+            { name: 'rotate', x: box.x + box.width / 2, y: box.y - 20 }
+        ]
+
+        for (const h of handles) {
+            if (Math.abs(pt.x - h.x) < handleSize && Math.abs(pt.y - h.y) < handleSize) {
+                return h.name as any
+            }
+        }
+        return null
+    }
+
+    function onPointerDown(e: PointerEvent) {
+        const pt = getCanvasPoint(e)
+
+        const hitHandle = hitTestHandles(pt)
+        if (hitHandle) {
+            if (hitHandle === 'rotate') {
+                const box = selectionBox.value!
+                const center = { x: box.x + box.width / 2, y: box.y + box.height / 2 }
+                const initialAngles = new Map()
+                selectedIds.value.forEach(id => {
+                    const s = shapes.value.find(s => s.id === id)
+                    if (s) initialAngles.set(id, s.transform.rotation)
+                })
+
+                interaction.value = {
+                    kind: 'rotate',
+                    shapeIds: Array.from(selectedIds.value),
+                    center,
+                    startAngle: Math.atan2(pt.y - center.y, pt.x - center.x),
+                    initialAngles
+                }
+            } else {
+                const box = selectionBox.value!
+                const initialTransforms = new Map()
+                selectedIds.value.forEach(id => {
+                    const s = shapes.value.find(s => s.id === id)
+                    if (s) initialTransforms.set(id, { ...s.transform })
+                })
+
+                interaction.value = {
+                    kind: 'scale',
+                    shapeIds: Array.from(selectedIds.value),
+                    handle: hitHandle,
+                    start: pt,
+                    initialBox: { ...box },
+                    initialTransforms
+                }
+            }
+            if (e.target) (e.target as HTMLElement).setPointerCapture(e.pointerId)
+            return
+        }
+
+        // Hit test shapes
+        let hitId = null
+        if (hitTestShape) {
+            hitId = hitTestShape(pt)
+        } else {
+            // Simple fallback hit test (rects)
+            for (let i = shapes.value.length - 1; i >= 0; i--) {
+                const s = shapes.value[i]
+                const dx = pt.x - s.transform.x
+                const dy = pt.y - s.transform.y
+                const cos = Math.cos(-s.transform.rotation)
+                const sin = Math.sin(-s.transform.rotation)
+                const lx = dx * cos - dy * sin
+                const ly = dx * sin + dy * cos
+                const sx = lx / s.transform.scaleX
+                const sy = ly / s.transform.scaleY
+
+                // Assuming 100x100 base if not specified
+                const w = (s as any).width || 100
+                const h = (s as any).height || 100
+
+                if (sx >= 0 && sx <= w && sy >= 0 && sy <= h) {
+                    hitId = s.id
+                    break
+                }
+            }
+        }
+
+        if (hitId) {
+            if (!selectedIds.value.has(hitId) && !e.shiftKey) {
+                selectedIds.value.clear()
+                selectedIds.value.add(hitId)
+            } else if (e.shiftKey) {
+                if (selectedIds.value.has(hitId)) selectedIds.value.delete(hitId)
+                else selectedIds.value.add(hitId)
+            }
+
+            if (selectedIds.value.size > 0) {
+                const initialPos = new Map()
+                selectedIds.value.forEach(id => {
+                    const s = shapes.value.find(s => s.id === id)
+                    if (s) initialPos.set(id, { x: s.transform.x, y: s.transform.y })
+                })
+
+                interaction.value = {
+                    kind: 'drag',
+                    shapeIds: Array.from(selectedIds.value),
+                    start: pt,
+                    initialPos
+                }
+                if (e.target) (e.target as HTMLElement).setPointerCapture(e.pointerId)
+            }
+        } else {
+            // Clicked empty space
+            selectedIds.value.clear()
+        }
+
+        scheduleRender()
+    }
+
+    function onPointerMove(e: PointerEvent) {
+        if (!interaction.value) return
+        const pt = getCanvasPoint(e)
+
+        if (interaction.value.kind === 'drag') {
+            const { start, initialPos, shapeIds } = interaction.value
+            const dx = pt.x - start.x
+            const dy = pt.y - start.y
+
+            shapeIds.forEach(id => {
+                const s = shapes.value.find(s => s.id === id)
+                if (s) {
+                    const init = initialPos.get(id)!
+                    s.transform.x = init.x + dx
+                    s.transform.y = init.y + dy
+                }
+            })
+        } else if (interaction.value.kind === 'scale') {
+            const { start, handle, initialBox, initialTransforms, shapeIds } = interaction.value
+            const dx = pt.x - start.x
+            const dy = pt.y - start.y
+
+            let sx = 1
+            let sy = 1
+
+            if (handle.includes('e')) sx = (initialBox.width + dx) / initialBox.width
+            if (handle.includes('w')) sx = (initialBox.width - dx) / initialBox.width
+            if (handle.includes('s')) sy = (initialBox.height + dy) / initialBox.height
+            if (handle.includes('n')) sy = (initialBox.height - dy) / initialBox.height
+
+            let pivotX = initialBox.x
+            let pivotY = initialBox.y
+            if (handle.includes('w')) pivotX = initialBox.x + initialBox.width
+            if (handle.includes('n')) pivotY = initialBox.y + initialBox.height
+            if (handle === 'n' || handle === 's') pivotX = initialBox.x + initialBox.width / 2
+            if (handle === 'e' || handle === 'w') pivotY = initialBox.y + initialBox.height / 2
+
+            shapeIds.forEach(id => {
+                const s = shapes.value.find(s => s.id === id)
+                if (s) {
+                    const init = initialTransforms.get(id)!
+                    const relX = init.x - pivotX
+                    const relY = init.y - pivotY
+
+                    s.transform.x = pivotX + relX * sx
+                    s.transform.y = pivotY + relY * sy
+                    s.transform.scaleX = init.scaleX * sx
+                    s.transform.scaleY = init.scaleY * sy
+                }
+            })
+        } else if (interaction.value.kind === 'rotate') {
+            const { center, startAngle, initialAngles, shapeIds } = interaction.value
+            const currentAngle = Math.atan2(pt.y - center.y, pt.x - center.x)
+            const delta = currentAngle - startAngle
+
+            shapeIds.forEach(id => {
+                const s = shapes.value.find(s => s.id === id)
+                if (s) {
+                    const initAngle = initialAngles.get(id)!
+                    s.transform.rotation = initAngle + delta
+                }
+            })
+        }
+
+        scheduleRender()
+    }
+
+    function onPointerUp(e: PointerEvent) {
+        if (interaction.value) {
+            interaction.value = null
+            if (onDragEnd) onDragEnd()
+            if (e.target) (e.target as HTMLElement).releasePointerCapture(e.pointerId)
+        }
+    }
+
+    return {
+        onPointerDown,
+        onPointerMove,
+        onPointerUp
+    }
+}

index 00000000..3c7dcf8a
--- /dev/null
+++ b/frontend/src/composables/useCanvasRenderer.ts
@@ -0,0 +1,130 @@
+import { ref, onMounted, onBeforeUnmount, Ref } from 'vue'
+import type { Shape } from '../model/transformTypes'
+
+export function useCanvasRenderer(
+    selectionBox?: Ref<{ x: number, y: number, width: number, height: number } | null>
+) {
+    const canvasRef = ref<HTMLCanvasElement | null>(null)
+    const shapes = ref<Shape[]>([])
+    let ctx: CanvasRenderingContext2D | null = null
+
+    let needsRender = false
+    let rafId: number | null = null
+
+    function scheduleRender() {
+        if (needsRender) return
+        needsRender = true
+        rafId = requestAnimationFrame(() => {
+            needsRender = false
+            drawAll()
+        })
+    }
+
+    function drawAll() {
+        if (!ctx || !canvasRef.value) return
+        const canvas = canvasRef.value
+        ctx.clearRect(0, 0, canvas.width, canvas.height)
+
+        // 1. Draw shapes
+        for (const shape of shapes.value) {
+            ctx.save()
+
+            // zastosuj transform obiektu
+            ctx.translate(shape.transform.x, shape.transform.y)
+            ctx.rotate(shape.transform.rotation)
+            ctx.scale(shape.transform.scaleX, shape.transform.scaleY)
+
+            ctx.beginPath()
+            ctx.lineWidth = shape.strokeWidth || 2
+            ctx.strokeStyle = shape.stroke || '#000'
+            ctx.fillStyle = shape.fill || 'transparent'
+
+            if (shape.type === 'polyline') {
+                if (shape.points.length > 0) {
+                    shape.points.forEach((p, i) => {
+                        if (i === 0) ctx!.moveTo(p.x, p.y)
+                        else ctx!.lineTo(p.x, p.y)
+                    })
+                }
+            } else if (shape.type === 'rect') {
+                // Default rect if points not provided or just use 0,0 to 100,100 base
+                // Assuming points define the base shape
+                if (shape.points && shape.points.length >= 2) {
+                    shape.points.forEach((p, i) => {
+                        if (i === 0) ctx!.moveTo(p.x, p.y)
+                        else ctx!.lineTo(p.x, p.y)
+                    })
+                    ctx.closePath()
+                } else {
+                    ctx.rect(0, 0, shape.width || 100, shape.height || 100)
+                }
+            }
+            if (shape.fill && shape.fill !== 'transparent') ctx.fill()
+            ctx.stroke()
+            ctx.restore()
+        }
+
+        // 2. Draw selection box and handles
+        if (selectionBox && selectionBox.value) {
+            const box = selectionBox.value
+            ctx.save()
+            ctx.setLineDash([6, 4])
+            ctx.lineWidth = 1
+            ctx.strokeStyle = '#2f80ff'
+            ctx.strokeRect(box.x, box.y, box.width, box.height)
+
+            // Draw handles
+            const handleSize = 8
+            ctx.fillStyle = '#fff'
+            ctx.strokeStyle = '#2f80ff'
+            ctx.setLineDash([])
+
+            const handles = [
+                { x: box.x, y: box.y }, // TL
+                { x: box.x + box.width, y: box.y }, // TR
+                { x: box.x + box.width, y: box.y + box.height }, // BR
+                { x: box.x, y: box.y + box.height }, // BL
+                // Midpoints
+                { x: box.x + box.width / 2, y: box.y }, // T
+                { x: box.x + box.width, y: box.y + box.height / 2 }, // R
+                { x: box.x + box.width / 2, y: box.y + box.height }, // B
+                { x: box.x, y: box.y + box.height / 2 }, // L
+                // Rotation handle (top)
+                { x: box.x + box.width / 2, y: box.y - 20, isRotation: true }
+            ]
+
+            for (const h of handles) {
+                ctx.beginPath()
+                if (h.isRotation) {
+                    ctx.arc(h.x, h.y, 4, 0, Math.PI * 2)
+                    // Line to box
+                    ctx.moveTo(h.x, h.y + 4)
+                    ctx.lineTo(h.x, box.y)
+                    ctx.stroke()
+                } else {
+                    ctx.rect(h.x - handleSize / 2, h.y - handleSize / 2, handleSize, handleSize)
+                    ctx.fill()
+                    ctx.stroke()
+                }
+            }
+
+            ctx.restore()
+        }
+    }
+
+    onMounted(() => {
+        if (!canvasRef.value) return
+        ctx = canvasRef.value.getContext('2d')
+        scheduleRender()
+    })
+
+    onBeforeUnmount(() => {
+        if (rafId != null) cancelAnimationFrame(rafId)
+    })
+
+    return {
+        canvasRef,
+        shapes,
+        scheduleRender,
+    }
+}
diff --git a/frontend/src/composables/useSelectionBox.ts b/frontend/src/composables/useSelectionBox.ts
new file mode 100644
index 00000000..795be8a0
--- /dev/null
+++ b/frontend/src/composables/useSelectionBox.ts
@@ -0,0 +1,67 @@
+import { computed, ref, Ref } from 'vue'
+import type { Shape, Vec2 } from '../model/transformTypes'
+
+export type SelectionBox = {
+    x: number
+    y: number
+    width: number
+    height: number
+}
+
+export function useSelectionBox(shapes: Ref<Shape[]>) {
+    const selectedIds = ref<Set<string>>(new Set())
+
+    const selectedShapes = computed(() =>
+        shapes.value.filter(s => selectedIds.value.has(s.id))
+    )
+
+    const selectionBox = computed<SelectionBox | null>(() => {
+        if (!selectedShapes.value.length) return null
+
+        const allPoints: Vec2[] = []
+        for (const shape of selectedShapes.value) {
+            // If shape has points, transform them. If not (e.g. simple rect defined by size?), we need a strategy.
+            // Assuming 'points' are the local definition of the shape.
+            // If points is empty, we might need to assume a bounding box.
+            // For now, follow the example which assumes shape.points exists.
+
+            let pointsToUse = shape.points;
+            if (!pointsToUse || !pointsToUse.length) {
+                const w = shape.width || 100;
+                const h = shape.height || 100;
+                pointsToUse = [{ x: 0, y: 0 }, { x: w, y: 0 }, { x: w, y: h }, { x: 0, y: h }];
+            }
+
+            for (const p of pointsToUse) {
+                // zastosuj transform obiektu, ┼╝eby dosta─ç world coords
+                const cos = Math.cos(shape.transform.rotation)
+                const sin = Math.sin(shape.transform.rotation)
+                const x = shape.transform.x + (p.x * shape.transform.scaleX * cos - p.y * shape.transform.scaleY * sin)
+                const y = shape.transform.y + (p.x * shape.transform.scaleX * sin + p.y * shape.transform.scaleY * cos)
+                allPoints.push({ x, y })
+            }
+        }
+
+        if (allPoints.length === 0) return null
+
+        const xs = allPoints.map(p => p.x)
+        const ys = allPoints.map(p => p.y)
+        const minX = Math.min(...xs)
+        const maxX = Math.max(...xs)
+        const minY = Math.min(...ys)
+        const maxY = Math.max(...ys)
+
+        return {
+            x: minX,
+            y: minY,
+            width: maxX - minX,
+            height: maxY - minY,
+        }
+    })
+
+    return {
+        selectedIds,
+        selectedShapes,
+        selectionBox,
+    }
+}
